import cv2
import numpy as np
import matplotlib.pyplot as plt

class FisheyeCalibration:
    def __init__(self, img_path):
        self.img_path = img_path
        self.img = None
        self.pre_processed_image = None
        self.cropped_img = None
        self.points = []

    def cropped_the_image(self, image):
        return image[10:-10, 100:-100]

    def show_image(self, windows_name, image):
        if image is None or image.size == 0:
            return
        cv2.imshow(windows_name, image)
        cv2.waitKey(0)
        cv2.destroyAllWindows()

    def read_image(self):
        self.img = cv2.imread(self.img_path, cv2.IMREAD_COLOR)
        if self.img is None:
            raise FileNotFoundError("Image not loaded or file path not correct.")
        self.cropped_img = self.cropped_the_image(self.img)

    def pre_processing_image(self):
        gray = cv2.cvtColor(self.cropped_img, cv2.COLOR_BGR2GRAY)
        blurred = cv2.GaussianBlur(gray, (7, 7), 0)
        _, thresh = cv2.threshold(blurred, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3))
        self.pre_processed_image = cv2.erode(thresh, kernel, iterations=1)

    def find_contours(self):
        contours, _ = cv2.findContours(self.pre_processed_image, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)
        debug_img = self.cropped_img.copy()
        cx_img = self.pre_processed_image.shape[1] // 2
        cy_img = self.pre_processed_image.shape[0] // 2

        square_half = 210
        x_valid_min = cx_img - square_half - 280
        x_valid_max = cx_img + square_half + 280
        y_valid_min = cy_img - square_half - 140
        y_valid_max = cy_img + square_half + 130

        points_left = []
        points_right = []

        for contour in contours:
            approx = cv2.approxPolyDP(contour, 0.04 * cv2.arcLength(contour, True), True)
            if len(approx) == 4 and cv2.isContourConvex(approx):
                x, y, w_rect, h_rect = cv2.boundingRect(approx)
                aspect_ratio = float(w_rect) / h_rect
                area = cv2.contourArea(contour)

                if 0.6 < aspect_ratio < 1.6 and 500 < area < 15000:
                    M = cv2.moments(approx)
                    if M["m00"] != 0:
                        cx = int(M["m10"] / M["m00"])
                        cy = int(M["m01"] / M["m00"])

                        # Téglalap alapú pozíciós szűrés
                        if not (x_valid_min <= cx <= x_valid_max and y_valid_min <= cy <= y_valid_max):
                            continue

                        # Ellipszis alapú szűrés
                        a = 600  # vízszintes fél-tengely
                        b = 400  # függőleges fél-tengely
                        dx = cx - cx_img
                        dy = cy - cy_img
                        if (dx ** 2) / (a ** 2) + (dy ** 2) / (b ** 2) > 1:
                            continue

                        # Pontokat balra vagy jobbra gyűjtjük
                        if cx < cx_img:
                            points_left.append((cx, cy))
                        else:
                            points_right.append((cx, cy))

        # Kiválasztjuk a középponthoz legközelebbi 80-80 pontot (ha annyi van)
        def closest_to_center(points, center_x):
            points_sorted = sorted(points, key=lambda p: abs(p[0] - center_x))
            return points_sorted[:80]

        points_left = closest_to_center(points_left, cx_img)
        points_right = closest_to_center(points_right, cx_img)

        self.points = points_left + points_right

        # Debug kirajzolás
        for (cx, cy) in self.points:
            cv2.circle(debug_img, (cx, cy), 3, (0, 0, 255), -1)

        print(f"🔍 Összesen {len(self.points)} középpont található.")
        self.show_image("Középpontok megjelenítése", debug_img)

    def sort_points_by_coordinates(self, points, rows, cols, flip_vertical=False, flip_horizontal=False,
                                   sort_by_y=True):
        if points is None or len(points) != rows * cols:
            print(f"⚠️ Hibás pontszám vagy None. Várt: {rows * cols}, Kapott: {len(points) if points else 0}")
            return []

        primary_sort = 1 if sort_by_y else 0  # y vagy x
        secondary_sort = 0 if sort_by_y else 1  # x vagy y

        # Pontok rendezése primary szerint (y vagy x)
        points_sorted = sorted(points, key=lambda p: p[primary_sort])

        rows_list = []
        for i in range(rows):
            row_pts = points_sorted[i * cols:(i + 1) * cols]
            row_sorted = sorted(row_pts, key=lambda p: p[secondary_sort])
            if flip_horizontal:
                row_sorted = row_sorted[::-1]
            rows_list.append(row_sorted)

        if flip_vertical:
            if rows == 2:
                rows_list[0], rows_list[1] = rows_list[1], rows_list[0]
            else:
                rows_list = rows_list[::-1]

        # Vizualizáció
        debug_img = self.cropped_img.copy()
        font = cv2.FONT_HERSHEY_SIMPLEX
        for row_idx, row in enumerate(rows_list):
            for col_idx, pt in enumerate(row):
                x, y = int(pt[0]), int(pt[1])
                cv2.circle(debug_img, (x, y), 4, (0, 255, 0), -1)
                cv2.putText(debug_img, f"{row_idx},{col_idx}", (x + 5, y - 5), font, 0.5, (0, 255, 255), 1)
        self.show_image("Rendezett pontok sorszámozva", debug_img)

        sorted_points = np.array([pt for row in rows_list for pt in row], dtype=np.float32)
        return sorted_points


    def is_in_trapezoid(self, x, y, cx, cy, square_size, height, expand):
        y_top = cy - square_size // 2
        y_bottom = cy + square_size // 2
        if y_top - height <= y < y_top:
            ratio = (y_top - y) / height
            half_width = (square_size / 2) + ratio * expand
            return cx - half_width <= x <= cx + half_width
        elif y_bottom < y <= y_bottom + height:
            ratio = (y - y_bottom) / height
            half_width = (square_size / 2) + ratio * expand
            return cx - half_width <= x <= cx + half_width
        return False

    def group_points_by_position(self):
        h, w = self.cropped_img.shape[:2]
        cx, cy = w // 2, h // 2
        square_size = 420
        trap_height = 180
        trap_expand = 180
        x_min = cx - square_size // 2
        x_max = cx + square_size // 2
        y_min = cy - square_size // 2
        y_max = cy + square_size // 2

        center, left, right, top, bottom = [], [], [], [], []
        for pt in self.points:
            x, y = pt
            if x_min <= x <= x_max and y_min <= y <= y_max:
                center.append(pt)
            elif self.is_in_trapezoid(x, y, cx, cy, square_size, trap_height, trap_expand):
                if y < y_min:
                    top.append(pt)
                elif y > y_max:
                    bottom.append(pt)
            elif x < x_min:
                left.append(pt)
            elif x > x_max:
                right.append(pt)

        panels = [center, right, left, top, bottom]
        debug_img = self.cropped_img.copy()
        colors = [(0, 255, 0), (0, 0, 255), (255, 0, 0), (255, 255, 0), (255, 0, 255)]
        labels = ["Center", "Right", "Left", "Top", "Bottom"]

        for pts, color, label in zip(panels, colors, labels):
            for p in pts:
                cv2.circle(debug_img, tuple(int(v) for v in p), 3, color, -1)
            print(f"{label}: {len(pts)} pont")

        self.show_image("Csoportosított pontok", debug_img)
        return panels

    def generate_panel_object_points(self, offset, grid_size=(8, 8), rotation_angles=(0, 0, 0)):
        square_size = 50.0
        objp = np.zeros((grid_size[0] * grid_size[1], 3), np.float32)
        objp[:, :2] = np.mgrid[0:grid_size[0], 0:grid_size[1]].T.reshape(-1, 2) * square_size
        objp[:, 1] = (grid_size[1] - 1) * square_size - objp[:, 1] # Ezt raktam bele pluszba

        center = np.array([(grid_size[0] - 1) * square_size / 2.0,
                           (grid_size[1] - 1) * square_size / 2.0,
                           0], dtype=np.float32)

        theta_x, theta_y, theta_z = np.deg2rad(rotation_angles)
        Rx = np.array([[1, 0, 0],
                       [0, np.cos(theta_x), -np.sin(theta_x)],
                       [0, np.sin(theta_x), np.cos(theta_x)]], dtype=np.float32)
        Ry = np.array([[np.cos(theta_y), 0, np.sin(theta_y)],
                       [0, 1, 0],
                       [-np.sin(theta_y), 0, np.cos(theta_y)]], dtype=np.float32)
        Rz = np.array([[np.cos(theta_z), -np.sin(theta_z), 0],
                       [np.sin(theta_z), np.cos(theta_z), 0],
                       [0, 0, 1]], dtype=np.float32)

        R = Rx @ Ry @ Rz

        objp -= center
        objp = objp @ R.T

        objp += center + np.array(offset, dtype=np.float32)
        return objp.astype(np.float32).reshape(-1, 1, 3)

    def draw_reprojection_error(self, imagePoints, objectPoints, rvecs, tvecs, K, D):
        vis = self.cropped_img.copy()
        colors = [(0, 255, 0), (0, 0, 255), (255, 0, 0), (0, 255, 255), (255, 0, 255)]
        for i, (objp, imgp, rvec, tvec) in enumerate(zip(objectPoints, imagePoints, rvecs, tvecs)):
            imgp_proj, _ = cv2.projectPoints(objp, rvec, tvec, K, D)
            for j in range(len(imgp)):
                pt_measured = tuple(int(x) for x in imgp[j].ravel())
                pt_projected = tuple(int(x) for x in imgp_proj[j].ravel())
                cv2.circle(vis, pt_measured, 3, (255, 0, 0), -1)
                cv2.circle(vis, pt_projected, 3, (0, 0, 255), 1)
                cv2.line(vis, pt_measured, pt_projected, colors[i % len(colors)], 1)
        self.show_image("Reprojection hibák", vis)

    def plot_3d_object_points(self, objectPoints):
        fig = plt.figure()
        ax = fig.add_subplot(111, projection='3d')
        colors = ['r', 'g', 'b', 'y', 'm']
        for panel, color in zip(objectPoints, colors):
            pts = panel.reshape(-1, 3)
            ax.scatter(pts[:, 0], pts[:, 1], pts[:, 2], c=color, label=color)
        ax.set_xlabel('X')
        ax.set_ylabel('Y')
        ax.set_zlabel('Z')
        plt.legend()
        plt.show()

    def run_calibration_fisheye(self):
        self.read_image()
        self.pre_processing_image()
        self.find_contours()

        if len(self.points) != 160:
            raise ValueError(f"Hiba: {len(self.points)} pont található, 160 helyett!")

        panels = self.group_points_by_position()
        sorted_panels = [
            self.sort_points_by_coordinates(panels[0], 8, 8, flip_vertical=True, flip_horizontal=True, sort_by_y=False),
            self.sort_points_by_coordinates(panels[1], 4, 8, flip_vertical=True, flip_horizontal=True, sort_by_y=False),
            self.sort_points_by_coordinates(panels[2], 4, 8, flip_vertical=True, flip_horizontal=True, sort_by_y=False),
            self.sort_points_by_coordinates(panels[3], 8, 2, flip_vertical=True, flip_horizontal=True, sort_by_y=False),
            self.sort_points_by_coordinates(panels[4], 8, 2, flip_vertical=True, flip_horizontal=True, sort_by_y=False)
        ]

        imagePoints = [np.array(p, dtype=np.float32).reshape(-1, 1, 2) for p in sorted_panels]
        objectPoints = [
            self.generate_panel_object_points((0, 0, 0), grid_size=(8, 8), rotation_angles=(0, 0, 0)),
            self.generate_panel_object_points((0, 250, 150), grid_size=(8, 4), rotation_angles=(-90, 0, 0)),
            self.generate_panel_object_points((0, -250, 150), grid_size=(8, 4), rotation_angles=(-90, 0, 180)),
            self.generate_panel_object_points((250, 0, 150), grid_size=(2, 8), rotation_angles=(0, 90, 0)),
            self.generate_panel_object_points((-250, 0, 150), grid_size=(2, 8), rotation_angles=(0, -90, 0))
        ]

        h, w = self.cropped_img.shape[:2]
        image_size = (w, h)

        # Inicializálás
        K = np.eye(3, dtype=np.float64)
        K[0, 0] = w
        K[1, 1] = h
        K[0, 2] = w / 2
        K[1, 2] = h / 2

        D = np.zeros((4, 1), dtype=np.float64)
        rvecs = []
        tvecs = []

        flags = (
                cv2.fisheye.CALIB_RECOMPUTE_EXTRINSIC +
                # cv2.fisheye.CALIB_CHECK_COND +
                cv2.fisheye.CALIB_FIX_SKEW
        )

        criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 200, 1e-6)

        print("🔧 Kalibráció folyamatban...")

        rms, K, D, rvecs, tvecs = cv2.fisheye.calibrate(
            objectPoints,
            imagePoints,
            image_size,
            K,
            D,
            rvecs,
            tvecs,
            flags=flags,
            criteria=criteria
        )

        print(f"🌟 Reprojection error: {rms:.4f}")
        print("📷 Kamera mátrix (K):\n", K)
        print("🔧 Torzítási együtthatók (D):\n", D)

        for i, (objp, imgp, rvec, tvec) in enumerate(zip(objectPoints, imagePoints, rvecs, tvecs)):
            imgp_proj, _ = cv2.projectPoints(objp, rvec, tvec, K, D)
            err = cv2.norm(imgp, imgp_proj, cv2.NORM_L2) / len(imgp)
            print(f"📌 Panel {i}: reprojection error = {err:.2f}")

        # Vizualizáció (opcionális)
        self.draw_reprojection_error(imagePoints, objectPoints, rvecs, tvecs, K, D)

        new_K = cv2.fisheye.estimateNewCameraMatrixForUndistortRectify(K, D, (w, h), np.eye(3), balance=0.5)
        map1, map2 = cv2.fisheye.initUndistortRectifyMap(K, D, np.eye(3), new_K, (w, h), cv2.CV_16SC2)
        undistorted_img = cv2.remap(self.cropped_img, map1, map2, interpolation=cv2.INTER_LINEAR)

        self.show_image("Torzításmentes kép", undistorted_img)
        cv2.imwrite("undistorted.png", undistorted_img)

calib = FisheyeCalibration("C854413F53803302_14_04_2025_14_15_41_EN.bmp")
calib.run_calibration_fisheye()
